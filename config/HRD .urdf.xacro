<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="HRD ">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <!-- use_fake_hardware: true (default) = FakeSystem mock; false = Gazebo -->
    <xacro:arg name="use_fake_hardware" default="true" />
    <!-- ros_hardware_interface: "none" suppresses main URDF's Gazebo ros2_control.
         For Gazebo mode, pass ros_hardware_interface:=position -->
    <xacro:arg name="ros_hardware_interface" default="none" />

    <!-- Import main HRD URDF (includes gazebo tags + conditional ros2_control) -->
    <xacro:include filename="$(find turn_on_hrd_robot)/HRD_description/HRD.urdf.xacro" />

    <!-- FakeSystem mock hardware – only included for mock mode -->
    <xacro:if value="${xacro.arg('use_fake_hardware')}">
        <xacro:include filename="HRD .ros2_control.xacro" />
        <xacro:HRD_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>
    </xacro:if>

    <!-- Gazebo joint_state publisher – publishes /joint_states directly from
         Gazebo physics, since the internal joint_state_broadcaster may not load. -->
    <xacro:unless value="${xacro.arg('use_fake_hardware')}">
        <gazebo>
            <plugin name="gazebo_ros_joint_state_pub" filename="libgazebo_ros_joint_state_publisher.so">
                <robot_namespace>/</robot_namespace>
            </plugin>
        </gazebo>
    </xacro:unless>

</robot>
